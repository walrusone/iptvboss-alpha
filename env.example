# Start the bundled Caddy HTTPS proxy. Clear this value only when you already
# have a reverse proxy running on the same host.
COMPOSE_PROFILES=caddy

# Public hostname for the bundled Caddy proxy. Point this name's DNS records
# at the Docker host before starting the stack.
IPTVBOSS_DOMAIN=boss.domain.com

# The image name is separate from its tag so a future release channel can be
# selected without editing compose.yaml.
IPTVBOSS_IMAGE=ghcr.io/walrusone/iptvboss-alpha
IPTVBOSS_TAG=alpha

# Port 8001 is kept on host loopback for local health checks and an existing
# reverse proxy on this host. Do not publish it to the Internet.
IPTVBOSS_HOST_IP=127.0.0.1
IPTVBOSS_HOST_PORT=8001

# Recommended HTTPS reverse-proxy mode. The bundled Caddy service and an
# existing same-host reverse proxy both use these values.
IPTVBOSS_XC_BEHIND_HTTPS_PROXY=true
IPTVBOSS_HTTPS_ONLY=false
IPTVBOSS_XC_BIND_ADDRESS=all

# Used only for direct HTTPS with /data/keystore.p12. Leave empty in proxy mode.
IPTVBOSS_XC_KEYSTORE_PASSWORD=

# Leave empty for the bundled Caddy service or a trusted same-host proxy.
IPTVBOSS_XC_TRUSTED_PROXIES=

# The container runs without root privileges. Most installations should keep
# these defaults.
IPTVBOSS_UID=10001
IPTVBOSS_GID=10001
