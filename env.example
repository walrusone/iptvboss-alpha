# Use "alpha" to follow the newest Alpha container, or pin a release such as 3.11.21.
IPTVBOSS_TAG=alpha

# The host port mapped to IPTVBoss's internal XC server port 8001.
IPTVBOSS_HOST_PORT=8001
IPTVBOSS_HOST_IP=0.0.0.0

# Direct HTTP is the default for local-network setup. Enable one of these
# secure modes for untrusted networks. Proxy mode takes precedence when both
# values are true.
IPTVBOSS_XC_BEHIND_HTTPS_PROXY=false
IPTVBOSS_HTTPS_ONLY=false

# Direct HTTPS also requires /data/keystore.jks and this password.
# IPTVBOSS_XC_KEYSTORE_PASSWORD=replace-with-keystore-password

# XC listener inside the container: all/0.0.0.0 or loopback/127.0.0.1.
# Normal bridge networking requires all.
IPTVBOSS_XC_BIND_ADDRESS=all

# Optional strict mode: comma-separated proxy IP addresses or CIDRs.
# IPTVBOSS_XC_TRUSTED_PROXIES=172.17.0.6/32,127.0.0.1/32

# UID/GID used by the container when accessing /data. Set these to the owner
# of a bind-mounted host directory (for example, an Unraid appdata share).
IPTVBOSS_UID=10001
IPTVBOSS_GID=10001
